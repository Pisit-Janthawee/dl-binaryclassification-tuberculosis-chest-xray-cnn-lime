<mxfile host="app.diagrams.net" pages="1"><diagram name="What this project builds: chest X-ray in, probability of tuberculosis out" id="tb_overview"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="520" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="What this project builds: chest X-ray in, probability of tuberculosis out" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1700" height="40" as="geometry"/></mxCell><mxCell id="n1" value="Chest X-ray&lt;br&gt;(PNG, any size)" style="fontFamily=Helvetica;fontColor=#000000;shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="140" height="80" as="geometry"/></mxCell><mxCell id="n2" value="Prepare&lt;br&gt;grayscale 224 x 224&lt;br&gt;+ CLAHE contrast" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="260" y="180" width="160" height="80" as="geometry"/></mxCell><mxCell id="n3" value="CNN&lt;br&gt;EfficientNetB0&lt;br&gt;(transfer learning)" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="485" y="180" width="170" height="80" as="geometry"/></mxCell><mxCell id="n4" value="P(TB)" style="fontFamily=Helvetica;fontColor=#000000;ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="180" width="80" height="80" as="geometry"/></mxCell><mxCell id="n5" value="P(TB) &gt;=&lt;br&gt;threshold?" style="fontFamily=Helvetica;fontColor=#000000;rhombus;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontSize=10