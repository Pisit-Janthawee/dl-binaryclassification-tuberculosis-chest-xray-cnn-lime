<mxfile host="app.diagrams.net" pages="1"><diagram name="Tuberculosis Screening: from X-ray files to an explained prediction" id="tb_pipeline"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="680" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="Tuberculosis Screening: from X-ray files to an explained prediction" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1700" height="40" as="geometry"/></mxCell><mxCell id="n1" value="Prepare and split" style="fontFamily=Helvetica;fontColor=#000000;rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="800" height="36" as="geometry"/></mxCell><mxCell id="n2" value="Train, choose the threshold, explain" style="fontFamily=Helvetica;fontColor=#000000;rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="60" width="820" height="36" as="geometry"/></mxCell><mxCell id="n3" value="" style="fontFamily=Helvetica;fontColor=#000000;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="800" height="540" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Group look-alike X-rays, then split by group&lt;/b&gt;" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="115" width="800" height="30" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Honest split&lt;/b&gt;&lt;br&gt;every test X-ray and its look-alikes stay out of training" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="780" height="70" as="geometry"/></mxCell><mxCell id="n6" value="4,200 X-rays&lt;br&gt;700 TB" style="fontFamily=Helvetica;fontColor=#000000;shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="45" y="228" width="110" height="64" as="geometry"/></mxCell><mxCell id="n7" value="Grayscale 224 px&lt;br&gt;+ CLAHE" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="180" y="228" width="120" height="64" as="geometry"/></mxCell><mxCell id="n8" value="Difference hash&lt;br&gt;group look-alikes" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="335" y="228" width="130" height="64" as="geometry"/></mxCell><mxCell id="n9" value="group&lt;br&gt;split" style="fontFamily=Helvetica;fontColor=#000000;rhombus;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="212" width="120" height="96" as="geometry"/></mxCell><mxCell id="n10" value="Train 70 %" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="675" y="138" width="110" height="64" as="geometry"/></mxCell><mxCell id="n11" value="Valid 15 %" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="675" y="228" width="110" height="64" as="geometry"/></mxCell><mxCell id="n12" value="Test 15 %" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="675" y="318" width="110" height="64" as="geometry"/></mxCell><mx