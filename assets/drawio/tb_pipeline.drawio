e=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;CLAHE&lt;/b&gt;&lt;br&gt;contrast per 8 x 8 tile&lt;br&gt;clip limit 2.0&lt;br&gt;faint patches easier to see" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n7" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Difference hash&lt;/b&gt;&lt;br&gt;16 x 16 grid -&gt; 256-bit fingerprint&lt;br&gt;&lt;= 10 differing bits = look-alike&lt;br&gt;look-alikes form one group" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="285" y="400" width="230" height="100" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n8" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;StratifiedGroupKFold&lt;/b&gt;&lt;br&gt;a group never spans two splits&lt;br&gt;TB share ~17 % in every split" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="420" width="270" height="80" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n9" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="" style="fontFamily=Helvetica;fontColor=#000000;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="820" height="540" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;EfficientNetB0 transfer learning&lt;/b&gt;" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="850" y="115" width="820" height="30" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;Screening model&lt;/b&gt;&lt;br&gt;threshold set on validation to catch 90 % of TB, reused on test" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="860" y="570" width="800" height="70" as="geometry"/></mxCell><mxCell id="n28" value="Train batches&lt;br&gt;+ online&lt;br&gt;augmentation" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="890" y="220" width="120" height="80" as="geometry"/></mxCell><mxCell id="n29" value="EfficientNetB0&lt;br&gt;head, then fine-tune" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1045" y="228" width="150" height="64" as="geometry"/></mxCell><mxCell id="n30" value="threshold&lt;br&gt;sensitivity 90 %" style="fontFamily=Helvetica;fontColor=#000000;rhombus;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1230" y="212" width="140" height="96" as="geometry"/></mxCell><mxCell id="n31" value="P(TB)" style="fontFamily=Helvetica;fontColor=#000000;ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1408" y="228" width="64" height="64" as="geometry"/></mxCell><mxCell id="n32" value="LIME&lt;br&gt;superpixels" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1525" y="138" width="110" height="64" as="geometry"/></mxCell><mxCell id="n33" value="Lungs-hidden&lt;br&gt;test" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1525" y="318" width="110" height="64" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n28" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="scores" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n29" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n30" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n31" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n31" target="n33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;Augmentation&lt;/b&gt;&lt;br&gt;rotate 5 deg, zoom 10 %&lt;br&gt;shift 5 %, contrast 10 %&lt;br&gt;no flips (heart stays left)" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="870" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n28" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n41" value="&lt;b&gt;Two phases&lt;/b&gt;&lt;br&gt;head: lr 1e-3, backbone frozen&lt;br&gt;last 20 layers: lr 1e-5" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1085" y="420" width="230" height="80" as="geometry"/></mxCell><mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n29" target="n41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n43" value="&lt;b&gt;Class weights + threshold&lt;/b&gt;&lt;br&gt;each TB X-ray counts ~5 x in the loss&lt;br&gt;WHO target: sens &gt;= 90 %, spec &gt;= 70 %" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1340" y="420" width="300" height="80" as="geometry"/></mxCell><mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n30" target="n43"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>